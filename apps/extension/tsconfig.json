{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2016" /* Specify ECMAScript target version: 'ES3' (default), 'ES5', 'ES2015', 'ES2016', 'ES2017', 'ES2018', 'ES2019' or 'ESNEXT'. */,
    "module": "ESNEXT" /* Specify module code generation: 'none', 'commonjs', 'amd', 'system', 'umd', 'es2015', or 'ESNext'. */,
    "jsx": "react" /* Specify JSX code generation: 'preserve', 'react-native', or 'react'. */,
    "typeRoots": [
      "./node_modules/@types",
      "../../node_modules/@types",
      "./@types"
    ],
    "baseUrl": ".",
    "paths": {
      // Shared with the standalone web client; see webpack.config.js.
      "@bitpoker/poker-core/*": ["../../../webapp/src/poker/*"],
      // Those shared sources sit outside this submodule and next to the
      // webapp's own node_modules, so without this TS would load a second copy
      // of @types/react for them and then reject every shared component as
      // "not a valid JSX element". Pin react to this workspace's copy.
      "react": ["../../node_modules/@types/react"],
      "react/*": ["../../node_modules/@types/react/*"],
      "react-dom": ["../../node_modules/@types/react-dom"],
      "react-dom/*": ["../../node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src/**/*", "../../../webapp/src/poker/**/*"]
}
